{
  "compilerOptions": {
    /* ---- Core Build Settings ---- */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,

    /* ---- Type Safety ---- */
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "resolveJsonModule": true,

    /* ---- React / Next.js ---- */
    "jsx": "preserve",
    "isolatedModules": true,
    "esModuleInterop": true,

    /* ---- Path Aliases ---- */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    /* ---- Next.js Plugin ---- */
    "plugins": [
      { "name": "next" }
    ]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.ts"
  ],

  "exclude": ["node_modules"]
}
